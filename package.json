{
  "name": "levelup-backend",
  "version": "1.0.0",
  "description": "LevelUp Balti CMS backend (Payload CMS + Next.js)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "typecheck": "tsc --noEmit",
    "deps:check": "pnpm outdated",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "graphql": "^16.14.2",
    "libphonenumber-js": "^1.13.16",
    "next": "16.4.3",
    "payload": "3.92.1",
    "plaiceholder": "^3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^20.9.0 || >=22",
    "pnpm": "^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "dompurify": ">=3.4.17",
      "happy-dom": ">=21.0.4",
      "graphql-scalars": ">=2.0.1"
    }
  },
  "packageManager": "pnpm@10.34.9"
}
