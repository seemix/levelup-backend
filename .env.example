# Required
DATABASE_URL=mongodb://127.0.0.1/levelup
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Allowed origins for CORS/CSRF (comma-free, one URL each)
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# Production only: cookie domain shared between admin and frontend (e.g. .levelupbalti.com)
COOKIE_DOMAIN=

# Optional: S3-compatible media storage (leave S3_BUCKET empty to use the local ./media folder)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
