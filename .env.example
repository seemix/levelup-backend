# Required
DATABASE_URL=mongodb://127.0.0.1/levelup
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Allowed origins for CORS/CSRF (comma-free, one URL each)
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# Production only: cookie domain shared between admin and frontend (e.g. .levelupbalti.com)
COOKIE_DOMAIN=

# Optional: S3-compatible media storage (leave S3_BUCKET empty to use the local ./media folder)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (Resend). Without RESEND_API_KEY emails are only logged to the console.
# The sender domain must be verified in Resend (SPF/DKIM), see docs/deployment.md. The key belongs only in .env.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@levelupbalti.com
EMAIL_FROM_NAME=LevelUp Barbershop

# Background jobs (emails, reminders) run inside the server process; set to false to disable (e.g. a separate worker)
JOBS_AUTORUN=true

# Development only: password of the users created by `pnpm seed` (admin@/manager@/barber1..3@levelup.local)
SEED_PASSWORD=levelup-dev-123
